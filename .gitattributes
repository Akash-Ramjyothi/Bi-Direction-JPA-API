############################################
# Normalize line endings automatically
############################################
* text=auto

############################################
# Shell Scripts (Unix)
############################################
*.sh text eol=lf
mvnw text eol=lf
gradlew text eol=lf

############################################
# Windows Scripts
############################################
*.cmd text eol=crlf
*.bat text eol=crlf
mvnw.cmd text eol=crlf
gradlew.bat text eol=crlf

############################################
# Source Code
############################################
*.java text eol=lf
*.kt text eol=lf
*.groovy text eol=lf
*.xml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.properties text eol=lf
*.json text eol=lf
*.md text eol=lf

############################################
# Frontend Files
############################################
*.js text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.jsx text eol=lf
*.css text eol=lf
*.scss text eol=lf
*.html text eol=lf

############################################
# Binary Files (do not modify)
############################################
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.jar binary
*.war binary
*.zip binary
